{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "mazdel/dayravel",
  "description": "Laravel module scaffolding commands with automatic module route discovery.",
  "keywords": [
    "laravel",
    "modules",
    "modular"
  ],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.27",
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Mazdel\\DayRavel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mazdel\\DayRavel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mazdel\\DayRavel\\DayRavelServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
